{
  "name": "kanami.js",
  "version": "0.1.12",
  "description": "Простенькая библиотека враппер реализации API для SocialCord",
  "keywords": [
    "socialcord",
    "kanami.js",
    "kanami",
    "wrapper",
    "api",
    "social"
  ],
  "homepage": "https://github.com/socialcord/kanami.js#readme",
  "bugs": {
    "url": "https://github.com/socialcord/kanami.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socialcord/kanami.js.git"
  },
  "license": "MIT",
  "author": "masero01 (https://github.com/masero01)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "docs": "typedoc --out docs src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "socket.io-client": "^4.8.3",
    "undici": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
